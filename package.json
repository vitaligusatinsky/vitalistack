{
  "name": "vitalistack-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "gate": "bun run typecheck && bun run lint && bun test gate && bun gate/run.ts && bun gate/ratchet.ts",
    "gate:prove": "bun gate/prove.ts",
    "prepare": "bun scripts/install-hooks.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-js": "npm:typescript@6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.156.2"
  }
}
