#!/bin/sh
# Runs before every push. Install with `bun install` (the prepare script).
# Git passes the refs being pushed on stdin; keep them for the commit check.
input=$(cat)
# Typecheck and lint look at the working tree. The gate's own test suite
# (about a minute) runs in `bun run gate` and in CI, not on every push.
bun run typecheck && bun run lint || exit 1
# The rules and the ratchet look at the pushed commits themselves.
printf '%s\n' "$input" | bun gate/pre-push.ts "$1"
